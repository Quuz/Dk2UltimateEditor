<Window x:Class="DK2MapEditor.App.Editing.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource History.Title}" Width="740" Height="580" MinWidth="580" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Brush.Background}" Foreground="{StaticResource Brush.Text}">
    <Grid Margin="14" Background="{StaticResource Brush.Background}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource History.Hint}" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <TextBlock x:Name="SummaryText" Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource History.Undo}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TreeView x:Name="UndoTree" Background="#181513" Foreground="{StaticResource Brush.Text}"/>
            </DockPanel>
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource History.Redo}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TreeView x:Name="RedoTree" Background="#181513" Foreground="{StaticResource Brush.Text}"/>
            </DockPanel>
        </Grid>
        <Button Grid.Row="3" Content="{DynamicResource History.Close}" IsCancel="True" HorizontalAlignment="Right" Click="Close_Click" Margin="0,12,0,0"/>
    </Grid>
</Window>

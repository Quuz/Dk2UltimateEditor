                                        <TextBlock Text="{DynamicResource Editor.Definitions.Jobs.Mana}" />
                                        <TextBox x:Name="DefinitionJobsMana" Width="120" TextChanged="DefinitionJobsDraft_Changed" PreviewKeyDown="DefinitionJobsNumber_KeyDown" />
                                        <WrapPanel>
                                            <RepeatButton x:Name="DefinitionJobsManaDecrease" Content="−" MinWidth="32" Delay="400" Interval="75" Tag="Mana:-1" ToolTip="{DynamicResource CreaturePages.Decrease}" Click="DefinitionJobsStep_Click" />
                                            <RepeatButton x:Name="DefinitionJobsManaIncrease" Content="+" MinWidth="32" Delay="400" Interval="75" Tag="Mana:1" ToolTip="{DynamicResource CreaturePages.Increase}" Click="DefinitionJobsStep_Click" />
                                        </WrapPanel>
                                    </StackPanel>
                                </WrapPanel>
                            </WrapPanel>
                            <WrapPanel Margin="0,6">
                                <Button x:Name="DefinitionJobsAdd" Content="{DynamicResource Editor.Definitions.Jobs.Add}" Tag="Add" Click="DefinitionJobsEdit_Click" />
                                <Button x:Name="DefinitionJobsChange" Content="{DynamicResource Editor.Definitions.Jobs.Change}" Tag="Change" Click="DefinitionJobsEdit_Click" />
                                <Button x:Name="DefinitionJobsRemove" Content="{DynamicResource Editor.Definitions.Jobs.Remove}" Tag="Remove" Click="DefinitionJobsEdit_Click" />
                            </WrapPanel>
                            <TextBlock x:Name="DefinitionJobsTotals" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <CheckBox x:Name="DefinitionJobsAcknowledged" Content="{DynamicResource Editor.Definitions.Jobs.Acknowledge}" Visibility="Collapsed" Margin="0,0,0,4" />
                            <TextBlock x:Name="DefinitionJobsHint" TextWrapping="Wrap" Style="{StaticResource MutedText}" />
                        </StackPanel>
                    </Expander>
                    <Expander x:Name="DefinitionProjectilePanel" Header="{DynamicResource Editor.Definitions.Projectile.Title}" Foreground="{StaticResource Brush.Text}" Visibility="Collapsed" Margin="0,0,0,6">
                        <StackPanel Margin="0,6,0,0">
                            <WrapPanel>
                                <ComboBox x:Name="DefinitionProjectileSlot" Width="210" DisplayMemberPath="Label" SelectionChanged="DefinitionProjectileSelection_Changed" />
                                <ComboBox x:Name="DefinitionProjectileType" Width="480" DisplayMemberPath="Label" SelectionChanged="DefinitionProjectileSelection_Changed" />
                                <Button x:Name="DefinitionProjectileApply" Content="{DynamicResource Editor.Definitions.Projectile.Apply}" Click="DefinitionProjectileApply_Click" />
                            </WrapPanel>
                            <WrapPanel Margin="0,6">
                                <StackPanel x:Name="DefinitionProjectileFirst" Margin="0,0,12,0">
                                    <TextBlock x:Name="DefinitionProjectileLabel1" Margin="0,0,0,4" />
                                    <TextBox x:Name="DefinitionProjectileData1" Width="220" TextChanged="DefinitionProjectileInput_Changed" PreviewKeyDown="DefinitionProjectileInput_KeyDown" />
                                    <WrapPanel x:Name="DefinitionProjectileData1Steps">
                                        <RepeatButton x:Name="DefinitionProjectileData1Decrease" Content="−" Tag="1:-1" MinWidth="32" Delay="400" Interval="75" ToolTip="{DynamicResource CreaturePages.Decrease}" Click="DefinitionProjectileStep_Click" />
                                        <RepeatButton x:Name="DefinitionProjectileData1Increase" Content="+" Tag="1:1" MinWidth="32" Delay="400" Interval="75" ToolTip="{DynamicResource CreaturePages.Increase}" Click="DefinitionProjectileStep_Click" />
                                    </WrapPanel>
                                    <ComboBox x:Name="DefinitionProjectileTarget" Width="400" DisplayMemberPath="Label" SelectionChanged="DefinitionProjectileTarget_Changed" />
                                </StackPanel>
                                <StackPanel x:Name="DefinitionProjectileSecond">
                                    <TextBlock x:Name="DefinitionProjectileLabel2" Margin="0,0,0,4" />
                                    <TextBox x:Name="DefinitionProjectileData2" Width="220" TextChanged="DefinitionProjectileInput_Changed" PreviewKeyDown="DefinitionProjectileInput_KeyDown" />
                                    <WrapPanel x:Name="DefinitionProjectileData2Steps">
                                        <RepeatButton x:Name="DefinitionProjectileData2Decrease" Content="−" Tag="2:-1" MinWidth="32" Delay="400" Interval="75" ToolTip="{DynamicResource CreaturePages.Decrease}" Click="DefinitionProjectileStep_Click" />
                                        <RepeatButton x:Name="DefinitionProjectileData2Increase" Content="+" Tag="2:1" MinWidth="32" Delay="400" Interval="75" ToolTip="{DynamicResource CreaturePages.Increase}" Click="DefinitionProjectileStep_Click" />
                                    </WrapPanel>
                                    <ComboBox x:Name="DefinitionProjectileLevel" Width="220" DisplayMemberPath="Label" SelectionChanged="DefinitionProjectileTarget_Changed" />
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock x:Name="DefinitionProjectileHint" TextWrapping="Wrap" Style="{StaticResource MutedText}" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
                </ScrollViewer>
                <DataGrid x:Name="DefinitionTable" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionChanged="DefinitionSelection_Changed" />
            </DockPanel>
        </TabItem>
    </TabControl>
</UserControl>

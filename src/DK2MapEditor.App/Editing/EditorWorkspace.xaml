<UserControl x:Class="DK2MapEditor.App.Editing.EditorWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DK2MapEditor.App.Editing">
    <UserControl.Resources>
        <local:DefinitionPanelHeightConverter x:Key="DefinitionPanelHeight" />
        <local:ScriptLabelWidthConverter x:Key="ScriptLabelWidth" />
        <DataTemplate x:Key="ScriptDescriptionChoice">
            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" MaxWidth="320" ToolTip="{Binding Label}" />
        </DataTemplate>
    </UserControl.Resources>
    <TabControl x:Name="WorkspaceTabs" Background="#181513" Foreground="#E7DDD0" SelectionChanged="WorkspaceTab_Changed">
        <TabItem Header="{DynamicResource Editor.Map}">
            <DockPanel>
                <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="164">
                <WrapPanel x:Name="MapToolbar" Margin="6">
                    <TextBlock Text="{DynamicResource Editor.Tool}" VerticalAlignment="Center" Margin="4" />
                    <ComboBox x:Name="ToolPicker" Width="155" SelectionChanged="Tool_Changed" Margin="4" />
                    <CheckBox x:Name="RandomPaintCheck" Content="{DynamicResource Paint.RandomToggle}" ToolTip="{DynamicResource Paint.RandomHint}" VerticalAlignment="Center" Margin="6,4" Click="RandomPaint_Click" />
                    <TextBlock Text="{DynamicResource Editor.Terrain}" VerticalAlignment="Center" Margin="4" />
                    <ComboBox x:Name="TerrainPicker" Width="155" SelectionChanged="Paint_Changed" Margin="4" />
                    <TextBlock Text="{DynamicResource Editor.Owner}" VerticalAlignment="Center" Margin="4" />
                    <ComboBox x:Name="OwnerPicker" Width="100" SelectionChanged="Paint_Changed" Margin="4" />
                    <TextBlock Text="{DynamicResource Editor.Variant}" VerticalAlignment="Center" Margin="4" />
                    <ComboBox x:Name="VariantPicker" Width="45" SelectionChanged="Paint_Changed" Margin="4">
                        <ComboBoxItem Content="1" IsSelected="True" /><ComboBoxItem Content="2" />
                    </ComboBox>
                    <Button Content="−" Click="ZoomOut_Click" ToolTip="{DynamicResource Editor.ZoomOut}" />
                    <Button Content="+" Click="ZoomIn_Click" ToolTip="{DynamicResource Editor.ZoomIn}" />
                    <ComboBox x:Name="ZoomPicker" Width="155" Margin="4" DisplayMemberPath="Label" SelectedValuePath="ID" SelectionChanged="ZoomPreset_Changed" ToolTip="{DynamicResource MapZoom.Title}" />
                    <Button Content="{DynamicResource MapZoom.Custom}" Click="CustomZoom_Click" />
                    <CheckBox x:Name="TerrainViewToggle" Content="{DynamicResource MapZoom.ShowTerrain}" IsChecked="True" Click="TerrainView_Click" VerticalAlignment="Center" Margin="4" />
                    <CheckBox x:Name="EntityToggle" Content="{DynamicResource Editor.Entities}" IsChecked="True" Click="Entities_Click" VerticalAlignment="Center" Margin="4" />
                    <Menu VerticalAlignment="Center" Margin="4"><MenuItem x:Name="ObjectViewMenu" Header="{DynamicResource MapObjects.Title}" /></Menu>
                    <Menu VerticalAlignment="Center" Margin="4"><MenuItem x:Name="OverlayViewMenu" Header="{DynamicResource MapOverlays.Title}" /></Menu>
                    <TextBox x:Name="PathColourInput" Width="70" Margin="4" VerticalAlignment="Center" ToolTip="{DynamicResource MapOverlays.PathColour}" />
                    <Button Content="{DynamicResource MapOverlays.PathColour}" Click="PathColour_Click" />
                    <CheckBox x:Name="PatrolToggle" Content="{DynamicResource Editor.PatrolShowPaths}" IsChecked="True" Click="PatrolToggle_Click" VerticalAlignment="Center" Margin="4" />
                    <Button Content="{DynamicResource Editor.Resize}" Click="Resize_Click" />
                    <CheckBox x:Name="OverviewToggle" Content="{DynamicResource Editor.Overview.Title}" IsChecked="True" Click="OverviewToggle_Click" VerticalAlignment="Center" Margin="4" />
                    <Button x:Name="FullscreenOverviewButton" Content="{DynamicResource Editor.Overview.Fullscreen}" ToolTip="{DynamicResource Editor.Overview.FullscreenHint}" Click="FullscreenOverview_Click" IsEnabled="False" />
                    <Button x:Name="ThumbnailButton" Content="{DynamicResource Thumbnail.Title}" Click="Thumbnail_Click" IsEnabled="False" />
                </WrapPanel>
                </ScrollViewer>
                <StackPanel DockPanel.Dock="Bottom" Margin="8">
                    <Expander x:Name="RegionToolsExpander" Header="{DynamicResource Editor.RegionTools}" Foreground="{StaticResource Brush.Text}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="180">
                    <StackPanel x:Name="RegionPanel">
                        <WrapPanel>
                            <ComboBox x:Name="RegionKindPicker" DisplayMemberPath="Label" SelectedValuePath="ID" Width="130" Margin="4" />
                            <ListBox x:Name="RegionPicker" DisplayMemberPath="Label" Width="340" Height="86" Margin="4"
                                     Background="#EEEAE3" Foreground="#201B16" BorderBrush="{StaticResource Brush.Border}"
                                     SelectionMode="Single" SelectionChanged="Region_Changed" MouseDoubleClick="RegionList_DoubleClick"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            <Button x:Name="RegionShowAllButton" Content="{DynamicResource Manager.AllRegions}" Click="RegionShowAll_Click" />
                            <Button x:Name="RegionShowButton" Content="{DynamicResource Editor.RegionShow}" Click="RegionShow_Click" />
                            <Button x:Name="RegionPropertiesButton" Content="{DynamicResource Editor.RegionProperties}" Click="RegionProperties_Click" />
                            <Button x:Name="RegionDeleteButton" Content="{DynamicResource Editor.Delete}" Click="RegionDelete_Click" />
                            <Button Content="{DynamicResource RegionRemoval.Reset}" Click="RegionRemovalReset_Click" />
                        </WrapPanel>
                        <WrapPanel>
                            <Button x:Name="RegionAddButton" Content="{DynamicResource RegionProperties.Add}" Click="RegionAdd_Click" />
                            <Button Content="{DynamicResource Editor.RegionAddSelection}" Tag="Add" Click="RegionUseSelection_Click" />
                            <Button Content="{DynamicResource Editor.RegionUseSelection}" Click="RegionUseSelection_Click" />
                            <Button Content="{DynamicResource Editor.RegionAddMap}" Tag="Add" Click="RegionChoose_Click" />
                            <Button Content="{DynamicResource Editor.RegionChangeMap}" Tag="Modify" Click="RegionChoose_Click" />
                            <Button Content="{DynamicResource Editor.RegionSelectMap}" Tag="Select" Click="RegionChoose_Click" />
                            <Button Content="{DynamicResource Editor.Cancel}" Click="RegionCancel_Click" />
                            <Button Content="{DynamicResource Editor.GeneratorTitle}" Click="OpenGenerator_Click" />
                        </WrapPanel>
                        <TextBlock x:Name="RegionStatus" TextWrapping="Wrap" Foreground="{StaticResource Brush.Warning}" Visibility="Collapsed" />
                    </StackPanel>
                    </ScrollViewer>
                    </Expander>
                    <TextBlock x:Name="PositionText" />
                    <TextBlock x:Name="FootprintStatus" TextWrapping="Wrap" Style="{StaticResource MutedText}" Visibility="Collapsed" />
                    <TextBlock x:Name="PlacementStatus" TextWrapping="Wrap" Foreground="{StaticResource Brush.Warning}" Visibility="Collapsed" />
                    <WrapPanel>
                    <DockPanel Margin="0,0,12,0">
                        <Image x:Name="SelectionInfoIcon" Width="32" Height="32" Margin="0,2,6,2" DockPanel.Dock="Left" />
                        <TextBlock x:Name="SelectionStatus" TextWrapping="Wrap" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel Margin="0,0,12,0">
                        <Image x:Name="ClipboardInfoIcon" Width="32" Height="32" Margin="0,2,6,2" DockPanel.Dock="Left" />
                        <TextBlock x:Name="ClipboardStatus" TextWrapping="Wrap" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel x:Name="GoldInfoPanel" Margin="0,6,0,0">
                        <Image x:Name="GoldInfoIcon" Width="32" Height="32" Margin="0,2,6,2" DockPanel.Dock="Left" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Editor.Statistics.TerrainGold}" />
                            <TextBlock x:Name="GoldInfoLevel" TextWrapping="Wrap" Style="{StaticResource MutedText}" />
                            <TextBlock x:Name="GoldInfoSelection" TextWrapping="Wrap" Style="{StaticResource MutedText}" />
                        </StackPanel>
                    </DockPanel>
                    </WrapPanel>
                    <TextBlock x:Name="TransformStatus" TextWrapping="Wrap" Foreground="{StaticResource Brush.Warning}" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel x:Name="OverviewPanel" DockPanel.Dock="Left" Margin="6,0,6,6">
                    <TextBlock Text="{DynamicResource Editor.Overview.Title}" Margin="0,0,0,4" />
                    <Border BorderBrush="#6E6252" BorderThickness="1" HorizontalAlignment="Left">
                        <local:MapOverview x:Name="Overview" Width="144" Height="144" ToolTip="{DynamicResource Editor.Overview.Hint}" />
                    </Border>
                    <CheckBox x:Name="OverviewProportions" IsChecked="True" Click="OverviewProportions_Click" Margin="0,6,0,4">
                        <TextBlock Text="{DynamicResource Editor.Overview.Proportions}" TextWrapping="Wrap" Width="126" />
                    </CheckBox>
                    <ComboBox x:Name="OverviewSize" Width="144" HorizontalAlignment="Left" SelectionChanged="OverviewSize_Changed" ToolTip="{DynamicResource Editor.Overview.Size}">
                        <ComboBoxItem Content="96 × 96" Tag="96" />
                        <ComboBoxItem Content="144 × 144" Tag="144" IsSelected="True" />
                        <ComboBoxItem Content="216 × 216" Tag="216" />
                        <ComboBoxItem Content="288 × 288" Tag="288" />
                    </ComboBox>
                </StackPanel>
                <ScrollViewer x:Name="MapScroll" ScrollChanged="MapScroll_Changed" SizeChanged="MapScroll_SizeChanged" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#111111">
                    <local:MapCanvas x:Name="Canvas" HorizontalAlignment="Left" VerticalAlignment="Top" />
                </ScrollViewer>
            </DockPanel>
        </TabItem>
        <TabItem Header="{DynamicResource Editor.Properties}">
            <Grid Margin="6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="5" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <DockPanel>
                    <ComboBox x:Name="CategoryPicker" DockPanel.Dock="Top" SelectionChanged="Category_Changed" Margin="0,0,0,6" />
                    <TextBox x:Name="RecordSearch" DockPanel.Dock="Top" TextChanged="Search_Changed" Margin="0,0,0,6" ToolTip="{DynamicResource Editor.Search}" />
                    <ListBox x:Name="RecordList" SelectionChanged="Record_Changed" />
                </DockPanel>
                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />
                <DockPanel Grid.Column="2" Margin="6,0,0,0">
                    <ScrollViewer x:Name="PropertiesTopScroll" DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type local:EditorWorkspace}}, Converter={StaticResource DefinitionPanelHeight}}">
                    <StackPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button x:Name="MapPropertiesButton" Content="{DynamicResource MapProperties.Title}" Click="MapProperties_Click" IsEnabled="False" />
                        <Button x:Name="LevelOptionsButton" Content="{DynamicResource LevelOptions.Title}" Click="LevelOptions_Click" IsEnabled="False" />
                        <Button x:Name="SpeechTextButton" Content="{DynamicResource SpeechText.Title}" Click="SpeechText_Click" IsEnabled="False" />
                        <ComboBox x:Name="TemplatePicker" Width="200" Margin="0,4,4,4" SelectionChanged="Template_Changed" />
                        <ComboBox x:Name="ElementPicker" Width="250" Margin="0,4,4,4" Visibility="Collapsed" ToolTip="{DynamicResource Editor.NamedElement}" />
                        <Button x:Name="ElementImagePickerButton" Content="{DynamicResource ObjectImages.Choose}" Click="ElementImagePicker_Click" Visibility="Collapsed" />
                        <Button x:Name="AddRecordButton" Content="{DynamicResource Editor.AddRecord}" Click="AddRecord_Click" />
                        <Button x:Name="ObjectBatchButton" Content="{DynamicResource Batch.Title}" Click="ObjectBatch_Click" IsEnabled="False" />
                        <Button x:Name="ObjectManagerButton" Content="{DynamicResource Manager.Title}" Click="ObjectManager_Click" IsEnabled="False" />
                        <Button Content="{DynamicResource Editor.Duplicate}" Click="DuplicateRecord_Click" />
                        <Button Content="{DynamicResource Editor.Delete}" Click="DeleteRecord_Click" />
                    </WrapPanel>
                    <ComboBox x:Name="EventTypePicker" DockPanel.Dock="Top" SelectionChanged="EventType_Changed" DisplayMemberPath="Label" Visibility="Collapsed" Margin="0,0,0,6" />
                    <Button x:Name="ScenarioAliasEventButton" Content="{DynamicResource AliasEvent.Title}" Click="ScenarioAliasEvent_Click" Visibility="Collapsed" Margin="0,0,0,6" />
                    <Button x:Name="ScenarioParameterButton" Content="{DynamicResource ScenarioPage.Title}" Click="ScenarioParameter_Click" Visibility="Collapsed" Margin="0,0,0,6" />
                    <Button x:Name="ScenarioEditEventButton" Content="{DynamicResource ScenarioWizard.EditCommand}" Click="ScenarioEditEvent_Click" Visibility="Collapsed" Margin="0,0,0,6" />
                    <TextBlock x:Name="RecordInfo" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <Button x:Name="CameraPathButton" DockPanel.Dock="Top" Content="{DynamicResource CameraPath.Open}" Click="CameraPath_Click" Visibility="Collapsed" Margin="0,0,0,6"/>
                    <StackPanel x:Name="BandPanel" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,0,0,6">
                        <Button Content="{DynamicResource HeroBand.Modify}" Click="HeroBandModify_Click" HorizontalAlignment="Left" />
                        <TextBlock Text="{DynamicResource Editor.BandMembers}" />
                        <ComboBox x:Name="BandSlotPicker" SelectionChanged="BandSlot_Changed" Margin="0,4,0,4" />
                        <WrapPanel>
                            <ComboBox x:Name="BandCreaturePicker" Width="250" Margin="0,4,4,4" ToolTip="{DynamicResource Editor.NamedElement}" />
                            <Button x:Name="BandImagePickerButton" Content="{DynamicResource ObjectImages.Choose}" Click="BandImagePicker_Click" />
                            <ComboBox x:Name="BandLevelPicker" DisplayMemberPath="Label" SelectedValuePath="ID" Width="95" Margin="0,4,4,4" ToolTip="{DynamicResource Field.Level}" />
                            <ComboBox x:Name="BandEnemyPicker" DisplayMemberPath="Label" SelectedValuePath="ID" Width="110" Margin="0,4,4,4" ToolTip="{DynamicResource Field.Enemy}" />
                            <Button x:Name="BandAddMemberButton" Content="{DynamicResource Editor.AddBandMember}" Click="AddBandMember_Click" />
                        </WrapPanel>
                        <WrapPanel>
                            <Button Content="{DynamicResource Editor.RemoveBandMember}" Click="RemoveBandMember_Click" />
                            <Button x:Name="BandMoveUpButton" Content="{DynamicResource Editor.MemberUp}" Click="BandMemberUp_Click" />
                            <Button x:Name="BandMoveDownButton" Content="{DynamicResource Editor.MemberDown}" Click="BandMemberDown_Click" />
                        </WrapPanel>
                        <TextBlock Text="{DynamicResource Editor.BandHint}" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,2,0,4" />
                    </StackPanel>
                    <Expander x:Name="EffectGeneratorPanel" Header="{DynamicResource Editor.EffectGenerator.Title}" Foreground="{StaticResource Brush.Text}" Visibility="Collapsed" Margin="0,0,0,6">
                        <StackPanel>
                            <WrapPanel>
                                <Button x:Name="EffectGeneratorApply" Content="{DynamicResource Editor.EffectGenerator.Apply}" Click="EffectGeneratorEdit_Click" />
                                <Button x:Name="EffectGeneratorRevert" Content="{DynamicResource Editor.EffectGenerator.Revert}" Tag="Revert" Click="EffectGeneratorEdit_Click" />
                            </WrapPanel>
                            <WrapPanel x:Name="EffectGeneratorFields" Margin="0,6,0,0" />
                            <TextBlock x:Name="EffectGeneratorHint" TextWrapping="Wrap" Style="{StaticResource MutedText}" />
                            <TextBlock x:Name="EffectGeneratorStatus" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Expander>
                    <StackPanel x:Name="NamedValuePanel" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,0,0,6">
                        <TextBlock x:Name="NamedFieldLabel" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource Editor.CatalogueHint}" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,2,0,4" />
                        <TextBox x:Name="NamedSearch" TextChanged="NamedSearch_Changed" ToolTip="{DynamicResource Editor.CatalogueSearch}" />
                        <WrapPanel>
                            <ComboBox x:Name="NamedValuePicker" MinWidth="250" MaxWidth="400" Margin="0,4,4,4" />
                            <Button x:Name="NamedImagePickerButton" Content="{DynamicResource ObjectImages.Choose}" Click="NamedImagePicker_Click" Visibility="Collapsed" />
                            <Button Content="{DynamicResource Editor.ApplyNamedValue}" Click="ApplyNamedValue_Click" />
                        </WrapPanel>
                    </StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                    <DataGrid x:Name="PropertyGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionChanged="PropertySelection_Changed" CellEditEnding="Field_EditEnding" Background="#EEEAE3" Foreground="#201B16" RowBackground="#EEEAE3" AlternatingRowBackground="#DDD7CC">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Editor.Field}" Binding="{Binding Label}" IsReadOnly="True" Width="*" MinWidth="240" />
                            <DataGridTextColumn Header="{DynamicResource Editor.Value}" Binding="{Binding Value, UpdateSourceTrigger=Explicit}" Width="*" MinWidth="140" />
                            <DataGridTextColumn Header="{DynamicResource Editor.NamedValue}" Binding="{Binding KnownValue}" IsReadOnly="True" Width="*" MinWidth="250" />
                            <DataGridTextColumn Header="{DynamicResource Editor.Offset}" Binding="{Binding Offset}" IsReadOnly="True" Width="90" MinWidth="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>
        </TabItem>
        <TabItem Header="{DynamicResource Editor.Scripts}">
            <Grid Margin="6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="5" /><ColumnDefinition Width="360" /></Grid.ColumnDefinitions>
                <DockPanel>
                <Button x:Name="ScenarioNamesButton" DockPanel.Dock="Top" Content="{DynamicResource ScenarioNames.Open}" Click="ScenarioNames_Click" IsEnabled="False" HorizontalAlignment="Left" />
                <TreeView x:Name="ScriptTree" SelectedItemChanged="ScriptTree_Changed" PreviewKeyDown="ScriptTree_KeyDown" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <TreeView.ItemContainerStyle><Style TargetType="TreeViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></Style></TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <DockPanel>
                            <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,1,4,1" DockPanel.Dock="Left" VerticalAlignment="Top">
                                <Image.Style><Style TargetType="Image"><Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Image.Style>
                            </Image>
                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" ToolTip="{Binding Label}">
                                <TextBlock.MaxWidth><MultiBinding Converter="{StaticResource ScriptLabelWidth}" ConverterParameter="Image">
                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=TreeView}" />
                                    <Binding RelativeSource="{RelativeSource AncestorType=TreeViewItem}" />
                                </MultiBinding></TextBlock.MaxWidth>
                            </TextBlock>
                            </DockPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                </DockPanel>
                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ScriptPanel" Margin="8,0,0,0">
                    <TextBlock x:Name="ScriptStatus" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <Button Content="{DynamicResource ScenarioDelete.Reset}" Click="ScenarioDeletionReset_Click" HorizontalAlignment="Left" />
                    <StackPanel x:Name="ScriptScopePanel" Margin="0,0,0,10">
                        <TextBlock Text="{DynamicResource Editor.ScriptOwner}" />
                        <ComboBox x:Name="ScriptScopePicker" DisplayMemberPath="Label" SelectedValuePath="ID" SelectionChanged="ScriptScopeFilter_Changed" Margin="0,4,0,4" />
                        <TextBox x:Name="ScriptOwnerSearch" TextChanged="ScriptOwnerSearch_Changed" ToolTip="{DynamicResource Editor.Search}" Margin="0,0,0,4" />
                        <ComboBox x:Name="ScriptOwnerPicker" />
                        <Button x:Name="ScriptNewPointButton" Content="{DynamicResource ScenarioPoint.New}" Click="ScriptNewPoint_Click" HorizontalAlignment="Left" />
                        <Button Content="{DynamicResource Editor.ScriptOpenScope}" Click="ScriptOpenScope_Click" HorizontalAlignment="Left" />
                        <Button x:Name="ScriptReassignButton" Content="{DynamicResource Editor.ScriptReassign}" Click="ScriptReassign_Click" HorizontalAlignment="Left" />
                        <Button x:Name="ScriptRemoveScopeButton" Content="{DynamicResource Editor.ScriptRemoveScope}" Click="ScriptRemoveScope_Click" HorizontalAlignment="Left" />
                        <WrapPanel>
                            <Button x:Name="ScriptInsertPointButton" Content="{DynamicResource ScenarioPoint.Insert}" Click="ScriptInsertPoint_Click" />
                            <Button x:Name="ScriptPointUpButton" Content="{DynamicResource ScenarioPoint.Up}" Click="ScriptPointUp_Click" />
                            <Button x:Name="ScriptPointDownButton" Content="{DynamicResource ScenarioPoint.Down}" Click="ScriptPointDown_Click" />
                        </WrapPanel>
                        <TextBlock Text="{DynamicResource Editor.ScriptScopeHint}" TextWrapping="Wrap" Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Editor.ScriptHint}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <Button Content="{DynamicResource Editor.ScriptProperties}" Click="ScriptProperties_Click" HorizontalAlignment="Left" />
                    <Button x:Name="ScriptEditEventButton" Content="{DynamicResource ScenarioWizard.EditCommand}" Click="ScriptEditEvent_Click" HorizontalAlignment="Left" IsEnabled="False" />
                    <WrapPanel>
                        <Button x:Name="ScriptNewRootButton" Content="{DynamicResource ScriptInsert.NewRoot}" Tag="NewRoot" Click="ScriptSourceInsert_Click" />
                        <Button x:Name="ScriptAppendConditionButton" Content="{DynamicResource ScriptInsert.AppendCondition}" Tag="AppendCondition" Click="ScriptSourceInsert_Click" />
                        <Button x:Name="ScriptInsertConditionButton" Content="{DynamicResource ScriptInsert.InsertCondition}" Tag="InsertCondition" Click="ScriptSourceInsert_Click" />
                        <Button x:Name="ScriptAppendActionButton" Content="{DynamicResource ScriptInsert.AppendAction}" Tag="AppendAction" Click="ScriptSourceInsert_Click" />
                        <Button x:Name="ScriptInsertActionButton" Content="{DynamicResource ScriptInsert.InsertAction}" Tag="InsertAction" Click="ScriptSourceInsert_Click" />
                    </WrapPanel>
                    <TextBlock Text="{DynamicResource ScriptInsert.Hint}" TextWrapping="Wrap" Style="{StaticResource MutedText}" />
                    <StackPanel x:Name="ScriptBranchPanel" Margin="0,8,0,8">
                        <WrapPanel>
                            <Button x:Name="ScriptMoveUpButton" Content="{DynamicResource Editor.ScriptMoveUp}" Tag="Up" Click="ScriptMoveDirection_Click" />
                            <Button x:Name="ScriptMoveDownButton" Content="{DynamicResource Editor.ScriptMoveDown}" Tag="Down" Click="ScriptMoveDirection_Click" />
                            <Button x:Name="ScriptIndentButton" Content="{DynamicResource Editor.ScriptIndent}" Tag="Indent" Click="ScriptMoveDirection_Click" />
                            <Button x:Name="ScriptOutdentButton" Content="{DynamicResource Editor.ScriptOutdent}" Tag="Outdent" Click="ScriptMoveDirection_Click" />
                        </WrapPanel>
                        <TextBlock Text="{DynamicResource Editor.ScriptMoveDestination}" />
                        <ComboBox x:Name="ScriptMovePicker" Margin="0,4,0,4" />
                        <Button Content="{DynamicResource Editor.ScriptMove}" Click="ScriptMove_Click" HorizontalAlignment="Left" />
                        <TextBlock Text="{DynamicResource Editor.ScriptBranchHint}" TextWrapping="Wrap" Style="{StaticResource MutedText}" />
                        <Button Content="{DynamicResource Editor.ScriptDeleteBranch}" Click="ScriptDeleteBranch_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Editor.ScriptLink}" Margin="0,8,0,3" />
                    <ComboBox x:Name="ScriptLinkPicker" ItemTemplate="{StaticResource ScriptDescriptionChoice}" SelectionChanged="ScriptLink_Changed" />
                    <TextBlock Text="{DynamicResource Editor.ScriptInsert}" Margin="0,8,0,3" />
                    <ComboBox x:Name="ScriptTypePicker" DisplayMemberPath="Label" />
                    <Button Content="{DynamicResource Editor.ScriptInsert}" Click="ScriptInsert_Click" HorizontalAlignment="Left" />
                    <TextBlock Text="{DynamicResource Editor.ScriptTarget}" Margin="0,8,0,3" />
                    <ComboBox x:Name="ScriptTargetPicker" />
                    <WrapPanel>
                        <Button Content="{DynamicResource Editor.ScriptAttach}" Click="ScriptAttach_Click" />
                        <Button Content="{DynamicResource Editor.ScriptDetach}" Click="ScriptDetach_Click" />
                    </WrapPanel>
                </StackPanel>
                </ScrollViewer>
            </Grid>
        </TabItem>
        <TabItem Header="{DynamicResource Editor.PatrolTitle}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <Grid Margin="6" MinWidth="520">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="120" /><ColumnDefinition Width="*" MinWidth="120" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                <DockPanel Margin="0,0,8,0">
                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Editor.PatrolRoutes}" />
                    <ListBox x:Name="PatrolRouteList" DisplayMemberPath="Label" SelectionChanged="PatrolRoute_Changed" />
                </DockPanel>
                <DockPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Editor.PatrolPoints}" />
                    <ListBox x:Name="PatrolPointList" SelectionChanged="PatrolPoint_Changed" />
                </DockPanel>
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PatrolPanel">
                        <StackPanel.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock Text="{DynamicResource Editor.PatrolStartArea}" />
                        <ComboBox x:Name="PatrolAreaPicker" SelectionChanged="PatrolArea_Changed" Margin="0,4" />
                        <TextBlock Text="{DynamicResource Editor.PatrolPause}" />
                        <TextBox x:Name="PatrolWait" Text="0" Margin="0,4" />
                        <Button x:Name="PatrolNewButton" Content="{DynamicResource Editor.PatrolNew}" Tag="New" Click="PatrolEdit_Click" />
                        <Button x:Name="PatrolStartButton" Content="{DynamicResource Editor.PatrolStart}" Tag="Start" Click="PatrolEdit_Click" />
                        <Button x:Name="PatrolAppendButton" Content="{DynamicResource Editor.PatrolAppend}" Tag="Append" Click="PatrolEdit_Click" />
                        <Button x:Name="PatrolInsertButton" Content="{DynamicResource Editor.PatrolInsert}" Tag="Insert" Click="PatrolEdit_Click" />
                        <Button x:Name="PatrolPauseButton" Content="{DynamicResource Editor.PatrolSetPause}" Tag="Pause" Click="PatrolEdit_Click" />
                        <Button Content="{DynamicResource Editor.RegionShow}" Click="PatrolShow_Click" />
                        <Button Content="{DynamicResource Editor.RegionProperties}" Click="PatrolProperties_Click" />
                        <Button x:Name="PatrolRemoveButton" Content="{DynamicResource Editor.PatrolRemove}" Tag="Remove" Click="PatrolEdit_Click" />
                        <Button x:Name="PatrolClearButton" Content="{DynamicResource Editor.PatrolClear}" Tag="Clear" Click="PatrolEdit_Click" />
                        <Button Content="{DynamicResource Editor.PatrolDrawStart}" Tag="Start" Click="PatrolDraw_Click" />
                        <Button Content="{DynamicResource Editor.PatrolDrawContinue}" Tag="Continue" Click="PatrolDraw_Click" />

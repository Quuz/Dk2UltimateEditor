<Window x:Class="DK2MapEditor.App.Editing.ThumbnailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Thumbnail.Title}" Width="760" Height="610" MinWidth="650" MinHeight="430"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource Brush.Background}" Foreground="{StaticResource Brush.Text}">
        <StackPanel Margin="14">
            <TextBlock Text="{DynamicResource Thumbnail.Hint}" TextWrapping="Wrap" Margin="0,0,0,10" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="168" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Width="150" Height="150" Padding="2" HorizontalAlignment="Left" VerticalAlignment="Top" BorderThickness="1" BorderBrush="{StaticResource Brush.Border}" Background="Black">
                    <Image x:Name="PreviewImage" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1">
                    <WrapPanel>
                        <TextBlock Text="{DynamicResource Thumbnail.Size}" VerticalAlignment="Center" Margin="4" />
                        <ComboBox x:Name="SizePicker" Width="200" SelectionChanged="Size_Changed" Margin="4">
                            <ComboBoxItem Content="{DynamicResource Thumbnail.Size144}" Tag="144" />
                            <ComboBoxItem Content="{DynamicResource Thumbnail.Size96}" Tag="96" />
                        </ComboBox>
                    </WrapPanel>
                    <CheckBox x:Name="KeepProportions" Content="{DynamicResource Editor.Overview.Proportions}" Click="Composition_Click" Margin="4" />
                    <CheckBox x:Name="UseColourKey" Click="Composition_Click" Margin="4">
                        <TextBlock Text="{DynamicResource Thumbnail.ColourKey}" TextWrapping="Wrap" MaxWidth="470" />
                    </CheckBox>
                    <WrapPanel>
                        <TextBlock Text="{DynamicResource Thumbnail.HiddenColour}" VerticalAlignment="Center" Margin="4" />
                        <TextBox x:Name="HiddenColourInput" Width="90" Margin="4" ToolTip="{DynamicResource Thumbnail.ColourFormat}" />
                        <Button x:Name="ApplyColourButton" Content="{DynamicResource Thumbnail.ApplyColour}" Click="ApplyColour_Click" />
                    </WrapPanel>
                    <WrapPanel>
                        <Button x:Name="RefreshButton" Content="{DynamicResource Thumbnail.Refresh}" Click="Refresh_Click" />
                        <Button x:Name="SaveButton" Content="{DynamicResource Thumbnail.Save}" Click="Save_Click" />
                    </WrapPanel>
                    <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="{StaticResource Brush.Warning}" Margin="4" />
                </StackPanel>
            </Grid>
            <TextBlock Text="{DynamicResource Thumbnail.World}" Margin="0,14,0,6" />
            <WrapPanel x:Name="WorldFlagsPanel" />
            <TextBlock Text="{DynamicResource Thumbnail.Players}" Margin="0,12,0,6" />
            <Grid x:Name="PlayerFlagsGrid" />
            <TextBlock Text="{DynamicResource Thumbnail.NoOverwrite}" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,12,0,4" />
        </StackPanel>
    </ScrollViewer>
</Window>

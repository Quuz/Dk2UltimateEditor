<Window x:Class="DK2MapEditor.App.Editing.CameraPathWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource CameraPath.Title}" Width="760" Height="640" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Brush.Background}" Foreground="{StaticResource Brush.Text}">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="HintText" Text="{DynamicResource CameraPath.Hint}" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DockPanel Margin="0,0,12,0">
                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" TextChanged="Search_Changed" ToolTip="{DynamicResource CameraPath.Search}" Margin="0,0,0,8"/>
                <ListBox x:Name="PathList" DisplayMemberPath="Label" SelectionChanged="Path_Changed"/>
            </DockPanel>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource Brush.Background}" Foreground="{StaticResource Brush.Text}">
                <StackPanel>
                    <TextBlock x:Name="PathTitle" FontSize="18" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Border Background="Black" Padding="2" HorizontalAlignment="Center"><Image x:Name="Diagram" Width="256" Height="192" Stretch="Uniform"/></Border>
                    <TextBlock x:Name="ModeText" TextWrapping="Wrap" Margin="0,10,0,8"/>
                    <TextBlock x:Name="DescriptionText" TextWrapping="Wrap"/>
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="ApplyButton" Content="{DynamicResource CameraPath.Apply}" Click="Apply_Click" IsDefault="True"/>
            <Button x:Name="CancelButton" Content="{DynamicResource CameraPath.Cancel}" Click="Cancel_Click" IsCancel="True"/>
        </WrapPanel>
    </Grid>
</Window>

<Application x:Class="DK2MapEditor.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Localization/Strings.en.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="Color.Background">#12100F</Color>
            <Color x:Key="Color.Panel">#1C1917</Color>
            <Color x:Key="Color.PanelRaised">#26211D</Color>
            <Color x:Key="Color.Border">#4A3C2D</Color>
            <Color x:Key="Color.Gold">#D6A84A</Color>
            <Color x:Key="Color.GoldBright">#F0CF78</Color>
            <Color x:Key="Color.Text">#EEE7DA</Color>
            <Color x:Key="Color.TextMuted">#A89D8C</Color>
            <Color x:Key="Color.Error">#E17062</Color>
            <Color x:Key="Color.Warning">#E3B34F</Color>
            <Color x:Key="Color.Success">#7DB47A</Color>

            <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
            <SolidColorBrush x:Key="Brush.Panel" Color="{StaticResource Color.Panel}" />
            <SolidColorBrush x:Key="Brush.PanelRaised" Color="{StaticResource Color.PanelRaised}" />
            <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
            <SolidColorBrush x:Key="Brush.Gold" Color="{StaticResource Color.Gold}" />
            <SolidColorBrush x:Key="Brush.GoldBright" Color="{StaticResource Color.GoldBright}" />
            <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
            <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
            <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}" />
            <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
            <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />

            <Style TargetType="Window">
                <Setter Property="Background" Value="{StaticResource Brush.Background}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style TargetType="Menu">
                <Setter Property="Background" Value="{StaticResource Brush.PanelRaised}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            </Style>
            <Style TargetType="MenuItem">
                <Setter Property="Background" Value="{StaticResource Brush.PanelRaised}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="Background" Value="{StaticResource Brush.PanelRaised}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="Margin" Value="3" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="#201B16" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Foreground" Value="#201B16" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Foreground" Value="#201B16" />
                <Setter Property="Background" Value="#EEEAE3" />
            </Style>
            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="#201B16" />
                <Setter Property="Background" Value="#EEEAE3" />
                <Style.Triggers>
                    <Trigger Property="IsHighlighted" Value="True">
                        <Setter Property="Background" Value="#DDD7CC" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource Brush.GoldBright}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="TabItem">
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                <Setter Property="HeaderTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="#201B16" />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="DataGrid">
                <Setter Property="Foreground" Value="#201B16" />
                <Setter Property="Background" Value="#EEEAE3" />
                <Setter Property="RowBackground" Value="#EEEAE3" />
                <Setter Property="AlternatingRowBackground" Value="#E4DFD5" />
            </Style>
            <Style TargetType="DataGridRow">
                <Setter Property="Foreground" Value="#201B16" />
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Foreground" Value="#201B16" />
                <Setter Property="Background" Value="#EEEAE3" />
            </Style>
            <Style TargetType="ListBox">
                <Setter Property="Foreground" Value="#201B16" />
                <Setter Property="Background" Value="#EEEAE3" />
            </Style>
            <Style TargetType="TreeView">
                <Setter Property="Foreground" Value="#201B16" />
                <Setter Property="Background" Value="#EEEAE3" />
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            </Style>
            <Style TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            </Style>
            <Style x:Key="PanelHeader" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Brush.GoldBright}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>
            <Style x:Key="MutedText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

  "rules": [
    {
      "id": "keeper_research_time_truncation",
      "family": "KeeperSpells",
      "fields": [
        "ResearchTime",
        "BonusRTime"
      ],
      "description": "Native loader uses 16-bit IMUL then logical SHR12. Result=(rawU16*low16(TPS) mod65536)>>12 and lies in0..15. It is not a direct research-point cost.",
      "evidence": {
        "file": "game-keeperspell-load-assembly.txt",
        "first": "0x4f7d78",
        "last": "0x4f7da8",
        "instructions": [
          "004f7d78: MOV EAX,dword ptr [ESI + 0x5c] ",
          "004f7d7b: TEST EAX,EAX ",
          "004f7d7d: JZ 0x004f7d92 ",
          "004f7d7f: MOV DX,word ptr [ESI + 0x150] ",
          "004f7d86: IMUL DX,CX ",
          "004f7d8a: SHR DX,0xc ",
          "004f7d8e: MOV word ptr [EDI + 0x5e],DX ",
          "004f7d92: MOV EAX,dword ptr [ESI + 0x30] ",
          "004f7d95: TEST EAX,EAX ",
          "004f7d97: JZ 0x004f7dac ",
          "004f7d99: MOV AX,word ptr [ESI + 0x189] ",
          "004f7da0: IMUL AX,CX ",
          "004f7da4: SHR AX,0xc ",
          "004f7da8: MOV word ptr [EDI + 0x60],AX "
        ]
      }
